# Dev container for the frontend. Used for all test and dev-server work.
#
# Build once:
#   podman build -f Containerfile.frontend-dev -t handy-recorder-frontend-dev .
#
# Run tests:
#   podman run --rm -v $(pwd)/frontend:/app -w /app handy-recorder-frontend-dev npm run test
#
# Run the dev server (reloads on changes in frontend/):
#   podman run --rm -p 5173:5173 -v $(pwd)/frontend:/app -w /app handy-recorder-frontend-dev

FROM node:26-slim

# Keep node_modules outside /app. The frontend/ bind mount hides anything under /app,
# and npm's script runner (and Node's module resolution) walk up from the cwd looking
# for node_modules, so installing one directory above /app still gets found.
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci && mv node_modules /node_modules
ENV NODE_PATH=/node_modules

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
