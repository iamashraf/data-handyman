# Backend-only production image: the API, with no bundled frontend.
# Used by the data-handyman compose stack (compose.yml), alongside
# Containerfile.frontend.
#
# Build: podman build -t data-handyman-backend -f Containerfile.backend .

FROM python:3.12-slim

RUN pip install --no-cache-dir uv==0.13.5

WORKDIR /app

# Install dependencies first so they're cached independently of app code.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev

COPY backend/app ./app

RUN mkdir -p /data

EXPOSE 8000
CMD ["uv", "run", "--no-dev", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
